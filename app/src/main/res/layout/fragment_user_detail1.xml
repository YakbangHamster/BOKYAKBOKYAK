<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg">

    <ImageView
        android:id="@+id/hamsterImage"
        android:layout_width="250dp"
        android:layout_height="150dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="150dp"
        android:layout_marginEnd="-86dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/side_hamster"
        android:translationZ="10dp" />

    <LinearLayout
        android:id="@+id/progressBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="60dp"
       >

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="8dp"
            android:background="@drawable/progress_bar_filled" />

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="8dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:background="@drawable/progress_bar_empty" />

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="8dp"
            android:background="@drawable/progress_bar_empty" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:layout_marginTop="60dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 뒤로가기 버튼 -->
            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/back"
                android:contentDescription="뒤로가기"
                android:layout_gravity="start"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="40dp" />

            <!-- 제목 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="복약복약이\n처음이신가요?"
                android:textSize="35sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <!-- 설명 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="더욱 정확한 리포트 분석을 위해\n상세 정보를 입력해 주세요!"
                android:textStyle="normal"
                android:textSize="15sp"
                android:textColor="#000000"
                android:layout_marginTop="4dp" />

            <!-- 이름 입력 -->
            <EditText
                android:id="@+id/editName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="이름"
                android:padding="12dp"
                android:background="@drawable/edittext_bg"
                android:textColorHint="#999999"
                android:textColor="#000000"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <!-- 나이 입력 -->
            <EditText
                android:id="@+id/editAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="나이"
                android:inputType="number"
                android:padding="12dp"
                android:background="@drawable/edittext_bg"
                android:textColorHint="#999999"
                android:textColor="#000000"
                android:layout_marginBottom="24dp" />

            <!-- 성별 선택 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="32dp">

                <FrameLayout
                    android:id="@+id/femaleOption"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/gender_circle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/femaleIcon"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/user"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="여성"
                            android:textSize="18sp"
                            android:textColor="#000000"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/maleOption"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/gender_circle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/maleIcon"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/user"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="남성"
                            android:textSize="18sp"
                            android:textColor="#000000"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>



            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNext1"
                style="@style/CustomButton"
                android:fontFamily="@font/pretendard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="다음으로"
                android:textColor="#FFFFFF"
                android:padding="0dp"
               />


        </LinearLayout>
    </ScrollView>
</FrameLayout>
