<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg">


    <LinearLayout
        android:id="@+id/progressBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="60dp"
        >

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="8dp"
            android:background="@drawable/progress_bar_filled" />

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="8dp"
            android:layout_marginStart="15dp"
            android:layout_marginEnd="15dp"
            android:background="@drawable/progress_bar_filled" />

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="8dp"
            android:background="@drawable/progress_bar_filled" />
    </LinearLayout>



    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:layout_marginTop="60dp"
        android:scrollbars="none"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 뒤로가기 버튼 -->
            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/back"
                android:contentDescription="뒤로가기"
                android:layout_gravity="start"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="40dp" />

            <!-- 제목 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="복약복약이\n처음이신가요?"
                android:textSize="35sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <ImageView
                android:id="@+id/hamsterImage"
                android:layout_width="250dp"
                android:layout_height="150dp"
                android:layout_gravity="end"
                android:layout_marginTop="-133.8dp"
                android:layout_marginEnd="-110dp"
                android:src="@drawable/side_hamster"
                android:translationZ="10dp" />

            <!-- 설명 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="더욱 정확한 리포트 분석을 위해\n상세 정보를 입력해 주세요!"
                android:textStyle="normal"
                android:textSize="15sp"
                android:textColor="#000000"
                android:layout_marginTop="-14.5dp" />

            <!-- 내과 질환 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="내과 질환"
                android:textSize="18dp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="3dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:alignmentMode="alignMargins"
                android:rowOrderPreserved="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHypertension"
                    style="@style/DiseaseButton"
                    android:text="고혈압" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDiabetes"
                    style="@style/DiseaseButton"
                    android:text="당뇨병" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnHyperlipidemia"
                    style="@style/DiseaseButton"
                    android:text="고지혈증" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAsthma"
                    style="@style/DiseaseButton"
                    android:text="천식" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGastritis"
                    style="@style/DiseaseButton"
                    android:text="소화불량" />
            </GridLayout>

            <!-- 소화기 질환 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="소화기 질환"
                android:textSize="18dp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="3dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:alignmentMode="alignMargins"
                android:rowOrderPreserved="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUlcer"
                    style="@style/DiseaseButton"
                    android:text="위염" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIrritableBowel"
                    style="@style/DiseaseButton"
                    android:layout_marginTop="-2.5dp"
                    android:text="과민성\n대장증후군" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReflux"
                    style="@style/DiseaseButton"
                    android:text="역류성식도염" />
            </GridLayout>

            <!-- 안과/피부 질환 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="안과/피부 질환"
                android:textSize="18dp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="3dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:alignmentMode="alignMargins"
                android:rowOrderPreserved="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAtopy"
                    style="@style/DiseaseButton"
                    android:text="아토피" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDryEye"
                    style="@style/DiseaseButton"
                    android:text="안구건조증" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConjunctivitis"
                    style="@style/DiseaseButton"
                    android:text="결막염" />
            </GridLayout>

            <!-- 정신 질환 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="정신 질환"
                android:textSize="18dp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="3dp" />

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:alignmentMode="alignMargins"
                android:rowOrderPreserved="false">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDepression"
                    style="@style/DiseaseButton"
                    android:text="우울증" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnInsomnia"
                    style="@style/DiseaseButton"
                    android:text="불면증" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAnxiety"
                    style="@style/DiseaseButton"
                    android:text="불안장애" />
            </GridLayout>


            <!-- 직접 입력 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="직접 입력"
                android:textSize="18dp"
                android:textColor="#000000"
                android:textStyle="bold"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp" />

            <EditText
                android:id="@+id/otherDiseaseInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="질환을 입력해 주세요"
                android:padding="12dp"
                android:background="@drawable/edittext_bg"
                android:textColor="#000000"
                android:textColorHint="#999999" />

            <!-- 시작 버튼 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStart"
                style="@style/CustomButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="복약복약 시작하기"
                android:textColor="#FFFFFF"
                android:layout_marginTop="44dp"/>

        </LinearLayout>
    </ScrollView>


</FrameLayout>
