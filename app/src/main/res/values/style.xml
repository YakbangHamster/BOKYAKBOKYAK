<resources>
    <style name="Theme.YakbangHamster" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="buttonStyle">@style/CustomButton</item>
    </style>

    <style name="DiseaseButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">100dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">7dp</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/disease_button_selector</item>
        <item name="android:textColor">@drawable/disease_button_text_selector</item>
        <item name="android:padding">1dp</item>
        <item name="android:textAppearance">@style/DiseaseButtonText</item>
    </style>

    <style name="DiseaseButtonText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:textSize">15dp</item>
        <item name="android:textStyle">normal</item>
    </style>


    <style name="CustomButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/rounded_blk_btn</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:textAppearance">@style/CustomButtonText</item>
        <item name="backgroundTint">@null</item>
    </style>

    <style name="CustomButtonText" parent="TextAppearance.MaterialComponents.Button">
        <item name="android:fontFamily">@font/pretendard</item>
    </style>

    <style name="PillButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:background">@drawable/search_chip_bg</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">#FFA726</item>
        <item name="android:textStyle">normal</item>
        <item name="android:textAppearance">@style/CustomButtonText</item>
        <item name="android:fontFamily">@font/pretendard</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="BottomSheetDialogTheme_NoDim" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="android:backgroundDimEnabled">false</item>
    </style>



    <style name="CalendarHeader" parent="TextAppearance.AppCompat.Large">
        <item name="android:textColor">#222222</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>

    <style name="CalendarWeekDay" parent="TextAppearance.AppCompat.Medium">
        <item name="android:textColor">#222222</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">@font/pretendard</item>
    </style>

    <style name="CalendarDate" parent="TextAppearance.AppCompat.Body1">
        <item name="android:textColor">#222222</item>
        <item name="android:textSize">19sp</item>
        <item name="android:fontFamily">@font/pretendard_semibold</item>
    </style>

</resources>