<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 상단바: 뒤로가기, 제목 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="35dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/arrow_left"
                    android:layout_marginRight="5dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="복약 레포트"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    android:textColor="#222222"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/userNameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="20dp"
                    android:paddingStart="34dp"
                    android:paddingEnd="24dp"
                    android:text="김햄찌 님의\n주간 레포트를\n소개할게요"
                    android:textColor="#222222"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="6dp"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/reportPeriodText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="2025년 3월 3일 ~ 2025년 3월 10일"
                    android:textColor="#222222"
                    android:textSize="15sp"
                    android:gravity="left"
                    android:layout_marginStart="34dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="0dp"/>

                <ImageView
                    android:id="@+id/hamsterImage"
                    android:layout_width="250dp"
                    android:layout_height="150dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="-132.5dp"
                    android:layout_marginEnd="-85.5dp"
                    android:src="@drawable/side_hamster"
                    android:translationZ="10dp" />

            </LinearLayout>

            <!-- 복약 횟수 요일별 BarChart -->
            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/barChart"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="5dp"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:background="@android:color/transparent"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/bg_report_card"
                android:layout_marginTop="-15dp"
                android:layout_marginBottom="30dp"
                android:layout_marginHorizontal="30dp"
                android:paddingVertical="6dp"
                android:paddingHorizontal="6dp">

                <TextView
                    android:id="@+id/topDayText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:gravity="center"
                    android:text="복약 횟수를 가장 잘 지킨 날은 목요일이에요.\n잘하고 계시네요!"
                    android:textColor="#1E232C"
                    android:textSize="16sp"
                    android:paddingVertical="16dp"
                    android:paddingHorizontal="8dp"
                    android:lineSpacingExtra="4dp"/>
            </LinearLayout>


            <!-- 복용약 비율 도넛형 PieChart -->
            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/pieChart"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="32dp"
                android:background="@android:color/transparent"/>

            <LinearLayout
                android:id="@+id/pieLegendLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="start"
                android:layout_marginStart="50dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="35dp"/>


            <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/bg_report_card"
                        android:layout_marginTop="-15dp"
                        android:layout_marginBottom="10dp"
                        android:layout_marginHorizontal="30dp"
                        android:paddingVertical="16dp"
                        android:paddingHorizontal="16dp">

                    <TextView
                        android:id="@+id/topMedicineText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAlignment="center"
                        android:gravity="center"
                        android:text="이번주에 가장 많이 복용한 약은 비타민이에요."
                        android:textColor="#1E232C"
                        android:textSize="16sp"
                        android:paddingVertical="16dp"
                        android:paddingHorizontal="8dp"/>


                </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginStart="60dp"
                    android:layout_marginTop="32dp"
                    android:layout_marginHorizontal="30dp">

                    <TextView
                        android:id="@+id/percentText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="58%"
                        android:textColor="#FFA149"
                        android:layout_marginLeft="20dp"
                        android:textSize="48sp"
                        android:textStyle="bold"
                        android:includeFontPadding="false"
                        android:paddingEnd="16dp"/>

                    <ImageView
                        android:id="@+id/reportPillPic"
                        android:layout_width="130dp"
                        android:layout_height="130dp"
                        android:src="@drawable/report_pill_pic"
                        android:contentDescription="@drawable/report_pill_pic"/>
                </LinearLayout>

                <!-- 설명 카드 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_report_card"
                    android:layout_marginTop="-15dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginHorizontal="30dp"
                    android:paddingVertical="20dp"
                    android:paddingHorizontal="20dp">

                    <TextView
                        android:id="@+id/percentDescText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="이번주에 산정된 김햄찌 님의 복약순응도예요.\n참고로, 만성 질환 노인 환자 중 복약순응도가\n80% 이상인 비율은 77.9%이라고 해요."
                        android:textColor="#1E232C"
                        android:textSize="16sp"
                        android:gravity="center"
                        android:includeFontPadding="false"/>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="120dp" />

        </LinearLayout>
    </ScrollView>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom" />

</FrameLayout>
