<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/mypage_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp">

            <!-- 상단바 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="35dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/arrow_left"
                    android:layout_marginRight="8dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="회원정보 수정"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    android:textColor="#222222"/>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="30dp"
                android:layout_marginBottom="24dp"
                android:gravity="center">

                <ImageView
                    android:id="@+id/profileImg"
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:src="@drawable/basic_profile"
                    android:layout_gravity="center"/>

                <ImageView
                    android:id="@+id/cameraIcon"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/profile_btn"
                    android:layout_gravity="bottom|end"
                    android:layout_marginBottom="-4dp"
                    android:layout_marginEnd="115dp"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이름"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginBottom="7dp"
                android:layout_marginTop="5dp"
                android:layout_marginStart="25dp"/>

            <EditText
                android:id="@+id/editName"
                android:layout_width="330dp"
                android:layout_height="45dp"
                android:hint="이름"
                android:background="@drawable/edittext_bg"
                android:textColorHint="#999999"
                android:textColor="#000000"
                android:paddingHorizontal="16dp"
                android:layout_gravity="center"
                android:layout_marginBottom="10dp"
                android:fontFamily="@font/pretendard"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="나이"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginBottom="7dp"
                android:layout_marginTop="5dp"
                android:layout_marginStart="25dp"/>

            <EditText
                android:id="@+id/editAge"
                android:layout_width="330dp"
                android:layout_height="45dp"
                android:hint="나이"
                android:inputType="number"
                android:background="@drawable/edittext_bg"
                android:textColorHint="#999999"
                android:textColor="#000000"
                android:paddingHorizontal="16dp"
                android:layout_gravity="center"
                android:layout_marginBottom="18dp"
                android:fontFamily="@font/pretendard"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="성별"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginBottom="7dp"
                android:layout_marginTop="5dp"
                android:layout_marginStart="25dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="20dp">

                <FrameLayout
                    android:id="@+id/femaleOption"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_marginEnd="20dp"
                    android:background="@drawable/gender_circle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/femaleIcon"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/user"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="여성"
                            android:textSize="18sp"
                            android:textColor="#8391A1"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/maleOption"
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_marginStart="20dp"
                    android:background="@drawable/gender_circle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/maleIcon"
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:src="@drawable/user"
                            android:layout_marginBottom="10dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="남성"
                            android:textSize="18sp"
                            android:textColor="#8391A1"
                            android:textStyle="bold" />
                    </LinearLayout>
                </FrameLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="나의 질환"
                android:textColor="#222222"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_marginBottom="7dp"
                android:layout_marginTop="5dp"
                android:layout_marginStart="25dp"/>

            <EditText
                android:id="@+id/editDisease"
                android:layout_width="330dp"
                android:layout_height="45dp"
                android:hint="나의 질환"
                android:background="@drawable/edittext_bg"
                android:textColorHint="#999999"
                android:textColor="#000000"
                android:paddingHorizontal="16dp"
                android:layout_gravity="center"
                android:layout_marginBottom="22dp"
                android:fontFamily="@font/pretendard"/>

            <Button
                android:id="@+id/btn_edit"
                android:layout_width="330dp"
                android:layout_height="45dp"
                android:layout_gravity="center"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="95dp"
                android:text="정보 수정"
                android:textColor="#FFFFFF"
                style="@style/CustomButton"
                android:background="@drawable/rounded_blk_btn"
                android:fontFamily="@font/pretendard"/>

        </LinearLayout>
    </ScrollView>

    <!-- 하단 네비게이션바 -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom" />

</FrameLayout>
