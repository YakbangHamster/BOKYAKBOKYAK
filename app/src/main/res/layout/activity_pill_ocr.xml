<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <!-- 상단바 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="35dp"
                android:paddingTop="20dp"
                android:paddingBottom="12dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/btn_back"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/arrow_left"
                    android:layout_marginRight="5dp"/>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="복용약 등록"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:gravity="start"
                    android:textColor="#222222"/>
            </LinearLayout>


            <androidx.cardview.widget.CardView
                android:layout_width="350dp"
                android:layout_height="400dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="80dp"
                android:layout_marginBottom="32dp"
                android:layout_gravity="center"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:gravity="center_horizontal"
                    android:background="@drawable/edittext_bg">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="약봉투 스캔"
                        android:textSize="19sp"
                        android:textStyle="bold"
                        android:textColor="#222222"
                        android:gravity="center"/>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="12dp"
                        android:background="#E8ECF4"/>

                    <TextView
                        android:fontFamily="@font/pretendard_medium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="사진과 같이 약봉투 사진이\n프레임 안에 들어가도록 촬영해 주세요."
                        android:textSize="16sp"
                        android:textColor="#222222"
                        android:gravity="center"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="6dp"/>


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="*약품명이 필수로 포함되어야 합니다*"
                        android:textSize="14sp"
                        android:textColor="#E93B5E"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp" />

                    <!-- 예시 이미지 -->
                    <ImageView
                        android:id="@+id/sample_image"
                        android:layout_width="330dp"
                        android:layout_height="230dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/scan_example"
                        android:background="@android:color/transparent"
                        android:contentDescription="약봉투 예시 이미지"
                        android:layout_marginTop="10dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/btn_camera"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="32dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/edittext_bg"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:fontFamily="@font/pretendard_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="사진 촬영"
                    android:textSize="17sp"
                    android:textColor="#1E232C"
                    android:gravity="center"/>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="19dp"
                    android:src="@drawable/camera"
                    android:layout_marginTop="1dp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/btn_gallery"
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:layout_marginStart="34dp"
                android:layout_marginEnd="32dp"
                android:background="@drawable/edittext_bg"
                android:orientation="horizontal"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:fontFamily="@font/pretendard_medium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="갤러리에서 선택"
                    android:textSize="17sp"
                    android:textColor="#1E232C"
                    android:gravity="center"/>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="19dp"
                    android:src="@drawable/gallery"
                    android:layout_marginTop="1dp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>


        </LinearLayout>

    </ScrollView>

    <!-- 하단 네비게이션 바 -->
    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/compose_nav_bar"
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="bottom" />

</FrameLayout>
