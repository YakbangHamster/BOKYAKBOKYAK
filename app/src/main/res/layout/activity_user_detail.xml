<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg">

    <ImageView
        android:id="@+id/hamsterImage"
        android:layout_width="250dp"
        android:layout_height="150dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="150dp"
        android:layout_marginEnd="-90dp"
        android:layout_marginBottom="20dp"
        android:src="@drawable/side_hamster"
        android:translationZ="10dp" />

    <LinearLayout
        android:id="@+id/progressBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="40dp">

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="6dp"
            android:background="@drawable/progress_bar_filled" />

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/progress_bar_empty" />

        <View
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="6dp"
            android:background="@drawable/progress_bar_empty" />
    </LinearLayout>



    <!-- 📜 본문 스크롤 뷰 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="24dp"
        android:layout_marginTop="60dp"> <!-- 상단바 높이만큼 여백 -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 뒤로가기 버튼 -->
            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/back"
                android:contentDescription="뒤로가기"
                android:layout_gravity="start"
                android:layout_marginBottom="24dp" />

            <!-- 제목 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="복약복약이\n처음이신가요?"
                android:textSize="35sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <!-- 설명 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="더욱 정확한 리포트 분석을 위해\n상세 정보를 입력해 주세요!"
                android:textStyle="normal"
                android:textSize="15sp"
                android:textColor="#000000"
                android:layout_marginTop="4dp" />

            <!-- 이름 입력 -->
            <EditText
                android:id="@+id/editName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="이름"
                android:padding="12dp"
                android:background="@drawable/edittext_bg"
                android:textColorHint="#999999"
                android:textColor="#000000"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="12dp" />

            <!-- 나이 입력 -->
            <EditText
                android:id="@+id/editAge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="나이"
                android:inputType="number"
                android:padding="12dp"
                android:background="@drawable/edittext_bg"
                android:textColorHint="#999999"
                android:textColor="#000000"
                android:layout_marginBottom="24dp" />

            <!-- 성별 선택 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:id="@+id/femaleOption"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="100dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/gender_circle"
                    android:layout_marginEnd="8dp">

                    <ImageView
                        android:id="@+id/femaleIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/user"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="여성"
                        android:textSize="16sp"
                        android:textColor="#000000"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/maleOption"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="100dp"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/gender_circle_inactive"
                    android:layout_marginStart="8dp">

                    <ImageView
                        android:id="@+id/maleIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@drawable/user"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="남성"
                        android:textSize="16sp"
                        android:textColor="#000000"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- 다음 버튼 -->
            <Button
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="다음으로"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:background="@drawable/rounded_blk_btn"
                android:padding="16dp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
