<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootWelcome"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_bg">

    <!-- 1) 일러스트 (햄스터 + 알약들) : 처음에는 화면 정중앙 -->
    <ImageView
        android:id="@+id/pillImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="25dp"
        android:src="@drawable/welcome_hamster"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2) 앱 이름: 약방햄스터 (햄스터에 더 바짝 + 위로) -->
    <TextView
        android:id="@+id/tvAppName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="약방햄스터"
        android:textSize="40sp"
        android:textStyle="bold"
        android:textColor="#FF38383A"
        android:fontFamily="@font/pretendard"
        android:layout_marginTop="-60dp"
    android:layout_marginBottom="4dp"
    app:layout_constraintTop_toBottomOf="@id/pillImage"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3) 한 줄(두 줄) 카피 (앱 이름에 거의 붙게) -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="당신의 복약을 도와줄 스마트한 AI 도구"
        android:textSize="26sp"
        android:textColor="#FF38383A"
        android:fontFamily="@font/pretendard_semibold"
        android:gravity="center"
        android:layout_marginTop="10dp"
    app:layout_constraintTop_toBottomOf="@id/tvAppName"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent" />

    <!-- 4) CTA 버튼 -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/startButton"
        style="@style/CustomButton"
        android:fontFamily="@font/pretendard"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:text="회원으로 시작하기"
        android:padding="0dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="102dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
